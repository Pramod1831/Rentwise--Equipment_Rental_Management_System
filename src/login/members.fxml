    <!-- =================== MAIN CENTER CONTENT =================== -->
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="membersTable" prefHeight="662.0" prefWidth="915.0" styleClass="custom-table-view">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="firstNameColumn" prefWidth="150.0" text="First Name" />
                        <TableColumn fx:id="lastNameColumn" prefWidth="150.0" text="Last Name" />
                        <TableColumn fx:id="usernameColumn" prefWidth="200.0" text="Username" />
                        <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
                    </columns>
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </VBox.margin>
                </TableView>
            </children>
        </VBox>
    </center>

</BorderPane>
