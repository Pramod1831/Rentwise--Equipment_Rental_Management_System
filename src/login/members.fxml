                                    </HBox.margin>
                                </ImageView>
                                <Label fx:id="equipments_side_label" text="Equipments" textFill="WHITE">
                                    <font>
                                        <Font name="Cambria Bold" size="22.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="10.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                            <styleClass>
                                <String fx:value="cursor_hand" />
                                <String fx:value="menu-hbox" />
                            </styleClass>
                        </HBox>

                        <!-- SETTINGS -->
                        <HBox alignment="CENTER_LEFT" prefHeight="58.0" style="-fx-background-radius: 15px; -fx-border-radius: 15px;" stylesheets="@dashboard.css">
                            <children>
                                <ImageView fx:id="notification_sideview_icon" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../Images/notification_admin.png" />
                                    </image>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </ImageView>
                                <Label fx:id="sideview_noti_label" text="Notification" textFill="WHITE">
                                    <font>
                                        <Font name="Cambria Bold" size="22.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="10.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                            <styleClass>
                                <String fx:value="cursor_hand" />
                                <String fx:value="menu-hbox" />
