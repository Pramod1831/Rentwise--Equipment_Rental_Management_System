                        <VBox VBox.vgrow="ALWAYS" />

                        <!-- LOGOUT -->
                        <HBox fx:id="logoutHBox" alignment="CENTER_LEFT" onMouseClicked="#handleLogout" prefHeight="58.0" style="-fx-background-radius: 15px; -fx-border-radius: 15px;" stylesheets="@dashboard.css">
                            <children>
                                <ImageView fx:id="logout_icon" fitHeight="30.0" fitWidth="30.0" onMouseClicked="#handleLogout" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../Images/logout.png" />
                                    </image>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </ImageView>
                                <Label fx:id="logout_label" onMouseClicked="#handleLogout" text="Logout" textFill="WHITE">
                                    <font>
                                        <Font name="Cambria Bold" size="22.0" />
